# Copy to .env and replace every example value. Do not commit .env.
CHAT_DB_CONNECTION=Server=host.docker.internal,1433;Database=ChatDB;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=True;
JWT_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES_LONG
JWT_ISSUER=ChatAPI
JWT_AUDIENCE=ChatClient
ADMIN_EMAIL=admin@example.com
PUBLIC_ORIGIN=https://your-pc.your-tailnet.ts.net
API_PORT=8080
WEB_PORT=8090
